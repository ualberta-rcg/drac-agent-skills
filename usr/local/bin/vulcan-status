#!/usr/bin/env bash
# vulcan-status — per-user login status renderer for the Vulcan cluster.
# Prints the full MOTD screen (logo + live blocks). Designed to be safe on the
# login path: every external call is timeout-bounded, missing data hides its
# block, and the script always exits 0.
#
# Data sources (speed): the Cluster block reads a root-baked flat file
# (/run/vulcan-motd/cluster, refreshed every 10 min by vulcan-motd-bake);
# fairshare + storage use a lazy per-user cache (USER_CACHE_DIR). Jobs are
# always live (freshness matters; the query is cheap). Missing/stale cache or
# a dead slurm source falls back to one bounded live compute.
# Flags: --plain  --no-cache  --only BLOCK  --user NAME (root)  --width N
# Blocks: header notice cluster jobs fairshare storage links

set -u
PATH=/usr/local/bin:/usr/bin:/bin

CONF=/etc/vulcan-motd/motd.conf
[ -r "$CONF" ] && . "$CONF"

# ---- defaults (override in motd.conf) ------------------------------------
ANNOUNCE=${ANNOUNCE:-/etc/vulcan-motd/announce.txt}
MAX_JOBS=${MAX_JOBS:-3}
MAX_PROJECTS=${MAX_PROJECTS:-3}
WIDE_MIN=${WIDE_MIN:-70}
CLUSTER_NAME=${CLUSTER_NAME:-$(hostname -s 2>/dev/null || echo vulcan)}
HOME_BASE=${HOME_BASE:-/home}
SCRATCH_BASE=${SCRATCH_BASE:-/scratch}
FS_BOOST=${FS_BOOST:-0.80}     # fairshare >= this  -> boosted   (top priority)
FS_AHEAD=${FS_AHEAD:-0.60}     # fairshare >= this  -> ahead
FS_NOMINAL=${FS_NOMINAL:-0.40} # fairshare >= this  -> nominal
FS_BEHIND=${FS_BEHIND:-0.20}   # fairshare >= this  -> behind; lower -> throttled
# One color per tier, best -> worst (colorblind-safe, see bar() below):
# bold turquoise, teal, blue, orange, bold light red.
# Storage bars use their own ramp (not the cluster-utilization one):
# teal under DISK_MID, blue under DISK_HIGH, bold red at/above it.
DISK_MID=${DISK_MID:-33}
DISK_HIGH=${DISK_HIGH:-66}
# LevelFS verdict bands (rendered in one light-blue family, direction carried
# by the good/nominal/bad word): high/inf = good (priority headroom — the
# account is under its allocation), low = bad.
LFS_LOW=${LFS_LOW:-0.75}
LFS_HIGH=${LFS_HIGH:-1.25}
Q_TIMEOUT=${Q_TIMEOUT:-3}      # per-query timeout, seconds
# ---- caching (see motd.conf) ---------------------------------------------
# Cluster block: read a root-baked flat file (vulcan-motd-bake, every 10 min)
# instead of querying Slurm at login. Fall back to live if older than
# CLUSTER_TTL or absent.
CACHE_DIR=${CACHE_DIR:-/run/vulcan-motd}
CLUSTER_CACHE=${CLUSTER_CACHE:-$CACHE_DIR/cluster}
HEARTBEAT=${HEARTBEAT:-$CACHE_DIR/heartbeat}
CLUSTER_TTL=${CLUSTER_TTL:-900}        # max age (s) before cluster falls back to live
# Per-user cache for slow-changing blocks (fairshare, storage). Lives under the
# user's own runtime dir (tmpfs, owned by the user, no privilege needed).
USER_CACHE_DIR=${USER_CACHE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/vulcan-motd}
FAIRSHARE_TTL=${FAIRSHARE_TTL:-900}    # fairshare cache age (s)
STORAGE_TTL=${STORAGE_TTL:-900}        # storage cache age (s)

# ---- args -----------------------------------------------------------------
PLAIN=0 NO_CACHE=0 ONLY="" WIDTH=0
TUSER=${USER:-$(id -un 2>/dev/null)}
while [ $# -gt 0 ]; do
    case "$1" in
        --plain)    PLAIN=1 ;;
        --no-cache) NO_CACHE=1 ;;
        --only)     ONLY=${2:-}; shift ;;
        --user)     TUSER=${2:-}; shift ;;
        --width)    WIDTH=${2:-0}; shift ;;
        -h|--help) WANT_HELP=1 ;;
        *) printf 'vulcan-status: unknown flag %s\n' "$1" >&2; exit 2 ;;
    esac
    shift
done
if [ "$TUSER" != "${USER:-}" ] && [ "$(id -u)" != "0" ]; then
    printf 'vulcan-status: --user requires root\n' >&2; exit 2
fi

# ---- color ----------------------------------------------------------------
USE_COLOR=1
if [ "$PLAIN" = 1 ] || [ -n "${NO_COLOR:-}" ] || [ "${TERM:-dumb}" = dumb ] || [ ! -t 1 ]; then
    USE_COLOR=0
fi
c() { [ "$USE_COLOR" = 1 ] && printf '\033[%sm' "$1"; return 0; }

# UTF-8 bars with ASCII fallback. Bars are the only glyphs that vary by
# locale; everything else added on top of the live script stays plain ASCII
# (the ↳ arrow rendered as tofu in real terminal fonts, so the hint prefix
# is plain '->' everywhere). ∞ = E2 88 9E, generated not pasted.
if [[ ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} == *[Uu][Tt][Ff]* ]]; then
    BAR_FULL='▓'; BAR_EMPTY='░'
    INF_SYM=$(printf '\xe2\x88\x9e')
else
    BAR_FULL='#'; BAR_EMPTY='-'
    INF_SYM='inf'
fi
HINT_ARROW='->'

# ---- width ----------------------------------------------------------------
if [ "$WIDTH" -le 0 ]; then
    case "${COLUMNS:-}" in ''|*[!0-9]*|0) WIDTH=$(tput cols 2>/dev/null || echo 80) ;; *) WIDTH=$COLUMNS ;; esac
    case "$WIDTH" in ''|*[!0-9]*) WIDTH=80 ;; esac
fi
if [ "$WIDTH" -ge "$WIDE_MIN" ]; then
    LAYOUT=wide; BARW=20; BARW_SMALL=14; NAMEW=16
else
    LAYOUT=compact; BARW=10; BARW_SMALL=10; NAMEW=12
fi

# ---- helpers --------------------------------------------------------------
# mkbar PCT WIDTH COLOR -> bar; bar PCT WIDTH -> health-colored bar
mkbar() {
    local pct=$1 w=$2 col=$3 filled fill empt
    filled=$(( pct * w / 100 )); [ "$filled" -gt "$w" ] && filled=$w
    printf -v fill '%*s' "$filled" '';          fill=${fill// /$BAR_FULL}
    printf -v empt '%*s' $(( w - filled )) '';  empt=${empt// /$BAR_EMPTY}
    c "$col"; printf '%s' "$fill"
    c '2';    printf '%s' "$empt"
    c '0'
}
# Bar/text status palette is COLORBLIND-SAFE: teal (ok) / orange (warn) /
# bold light red (critical) — distinctions survive red-green colorblindness
# because they differ in hue along the blue↔yellow axis AND in lightness,
# never green-vs-red. Fill length is always the primary signal; color is
# reinforcement only.
bar() {
    local col='38;5;79'
    [ "$1" -ge 80 ] && col='38;5;214'; [ "$1" -ge 95 ] && col='1;38;5;203'
    mkbar "$1" "$2" "$col"
}

# storage bar: usage-based ramp — teal < DISK_MID, blue < DISK_HIGH, bold red
# at/above (deliberately not the cluster-utilization ramp in bar()).
dbar() {
    local col='38;5;79'
    [ "$1" -ge "$DISK_MID" ] && col='38;5;75'; [ "$1" -ge "$DISK_HIGH" ] && col='1;38;5;203'
    mkbar "$1" "$2" "$col"
}

hdr() { # hdr TITLE [EXTRA]
    printf '\n'
    c '1'; printf '» %s' "$1"; c '0'
    [ -n "${2:-}" ] && printf '   %s' "$2"
    printf '\n'
}

hint() { # hint CMD — dim "for more detail" line at the foot of a block
    c '38;5;252'; printf '  %s Want more detail? Run: %s\n' "$HINT_ARROW" "$1"; c '0'
}

# Strip control characters from Slurm-derived strings before printing.
# Job names, pending reasons, TRES strings, account and project names are
# user-controllable; unfiltered they can inject ANSI/OSC terminal escape
# sequences into whatever terminal renders this banner (internal security
# finding — sanitize at the output boundary, before any truncation).
sanitize() { printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177'; }

# --help renders the real banner with a titled explanation section under
# each block (blank line, bold title, plain-white body — gray was too hard
# to read). Links get no section — they explain themselves. Text mirrors
# the channel-approved mockup.
explain_cluster() {
    printf '\n'
    c '1'
    printf '    Cluster — totals for every machine on Vulcan, refreshed every 10 minutes\n'
    c '0'
    printf '      Nodes   machines the scheduler can start jobs on; "(N down)" ones\n'
    printf '              cannot take jobs until they are fixed\n'
    printf '      Queue   every job on the cluster — running now vs pending (waiting\n'
    printf '              for their turn)\n'
    printf '      CPUs    processor cores in use vs total, across the whole cluster\n'
    printf '              — this is overall load, not your personal usage\n'
    printf '      Mem     memory (RAM) reserved by running jobs vs total — where the\n'
    printf '              data being worked on lives\n'
    printf '      GPUs    accelerator cards — the expensive part. "avail" is GPUs\n'
    printf '              with no job running on them; "usable" is how many of\n'
    printf '              those you could actually get a job onto right now. A GPU\n'
    printf '              can be idle but stuck if its node'"'"'s RAM or CPU cores are\n'
    printf '              already claimed by something else — avail counts the\n'
    printf '              GPU, usable checks whether the rest of that node has room\n'
    printf '              too. No per-user cap on Vulcan — when usable hits 0,\n'
    printf '              fairshare decides who gets the next one that frees up\n'
}

explain_jobs() {
    printf '\n'
    c '1'
    printf '    Your jobs — your own jobs, live from the queue\n'
    c '0'
    printf '      up       how long the job has been running\n'
    printf '      left     time before it hits its limit and gets killed\n'
    printf '      gres/…   hardware the job reserved — e.g. gres/gpu:l40s:1 means\n'
    printf '               one L40S GPU\n'
    printf '      held     a job waiting in queue; the word after it says why:\n'
    printf '                 Priority     other users are ahead of you\n'
    printf '                 Resources    the cluster is full — starts when hardware\n'
    printf '                              frees up\n'
    printf '                 Dependency   waiting for another of your jobs to finish\n'
}

explain_fairshare() {
    printf '\n'
    c '1'
    printf '    Fairshare — who goes first when the cluster is full\n'
    c '0'
    printf '      Read each row left to right:\n'
    printf '      account   the project this row is about — each project you belong\n'
    printf '                to gets its own row\n'
    printf '      factor    the fairshare priority factor — where do you stand\n'
    printf '                relative to other groups? Shown as a bar and a number\n'
    printf '                from 0 to 1. 1 is the HIGHEST — you have barely used\n'
    printf '                your share of the cluster, so your jobs go to the front\n'
    printf '                of the queue. 0 is the LOWEST — you have used far more\n'
    printf '                than your share, so your jobs wait the longest. It\n'
    printf '                recovers on its own: past usage counts a little less\n'
    printf '                each day.\n'
    printf '      LevelFS   has your group used more than its share? This is the\n'
    printf '                group'"'"'s ratio of shares to usage — 0 is the lowest,\n'
    printf '                infinity the highest. High or inf = much of the group'"'"'s\n'
    printf '                share still unused (good) · low = the group has used\n'
    printf '                more than its share\n'
}

explain_storage() {
    printf '\n'
    c '1'
    printf '    Storage — how full your directories are\n'
    c '0'
    printf '      Bar colour: comfortable under 33%% · getting full under 66%% ·\n'
    printf '      nearly full at 66%% and above\n'
    printf '      home        50 GB, backed up, permanent — code, configs, small files\n'
    printf '      scratch     5 TB, fast, NOT backed up — working data only; files\n'
    printf '                  not touched for 60 days are deleted automatically\n'
    printf '      <account>   one row per project you belong to, named after the\n'
    printf '                  account (matches the names under Fairshare above) —\n'
    printf '                  shared with your group, backed up, permanent\n'
}

# thousands separator for readability (15936 -> 15,936)
thou() { printf "%'d" "$1" 2>/dev/null || printf '%d' "$1"; }

# ---- ww/heartbeat health (from vulcan-motd-bake) --------------------------
CTLD=1; DBD=1
if [ -r "$HEARTBEAT" ]; then
    while IFS= read -r kv; do
        case "$kv" in
            ctld=0) CTLD=0 ;;
            dbd=0)  DBD=0  ;;
        esac
    done < "$HEARTBEAT"
fi

# fresh FILE TTL -> 0 if file exists and is newer than TTL seconds, else 1
cache_fresh() { [ -r "$1" ] && [ -z "$(find "$1" -mmin +"$(( ($2+59)/60 ))" 2>/dev/null)" ]; }

# cluster key=value cache -> shell vars (defensive parse). Returns 0 only if it
# populated enough fields to render. Honors CLUSTER_TTL via cache_fresh.
cluster_from_cache() {
    [ "$NO_CACHE" = 0 ] || return 1
    cache_fresh "$CLUSTER_CACHE" "$CLUSTER_TTL" || return 1
    local k v n=0
    while IFS='=' read -r k v; do
        case "$k" in
            nodes_up|nodes_down|cpu_alloc|cpu_total|mem_alloc_mb|mem_total_mb|gpu_alloc|gpu_total|queue_r|queue_pd|gpu_usable)
                case "$v" in *[!0-9]*|'') continue ;; esac
                printf -v "$k" '%s' "$v"; n=$((n+1)) ;;
        esac
    done < "$CLUSTER_CACHE"
    [ "$n" -ge 6 ]
}

# ============================================================================
# Blocks
# ============================================================================

render_header() {
    local L
    c '1;36'
    while IFS= read -r L; do printf '%s\n' "$L"; done <<'LOGO'
             _
            | |
__   ___   _| | ___ __ _ _ __
\ \ / / | | | |/ __/ _` | '_ \
 \ V /| |_| | | (_| (_| | | | |
  \_/  \__,_|_|\___\__,_|_| |_|
LOGO
    c '0'
    printf '\n'
    c '1;37'; printf 'University of Alberta // Alberta Machine Intelligence Institute\n'; c '0'
    c '2;37'; printf 'Digital Research Alliance of Canada\n'; c '0'
    if [ "$LAYOUT" = wide ]; then
        c '38;5;252'; printf 'node %s · user %s · %s\n' "$CLUSTER_NAME" "$TUSER" "$(date '+%Y-%m-%d %H:%M %Z')"; c '0'
    else
        c '38;5;252'; printf '%s · %s · %s\n' "$CLUSTER_NAME" "$TUSER" "$(date '+%Y-%m-%d %H:%M %Z')"; c '0'
    fi
}

render_notice() {
    [ -s "$ANNOUNCE" ] || return 0
    hdr 'Notice'
    c '33'
    sed 's/^/  /' "$ANNOUNCE"
    c '0'
}

cluster_compute_live() {
    command -v sinfo >/dev/null 2>&1 || return 1
    local s
    s=$(timeout "$Q_TIMEOUT" sinfo -h -o '%D %t' 2>/dev/null) || return 1
    [ -n "$s" ] || return 1
    eval "$(printf '%s\n' "$s" | awk '
        { tot=$1; if ($2 ~ /^(down|drain|drng|drng@|drain@|unk|fail|maint|resv)/) d+=tot; else u+=tot }
        END { printf "nodes_up=%d nodes_down=%d\n", u, d }')"
    s=$(timeout "$Q_TIMEOUT" sinfo -h -o '%C' 2>/dev/null) && [ -n "$s" ] && \
        eval "$(printf '%s' "$s" | awk -F/ '{ printf "cpu_alloc=%d cpu_total=%d\n", $1, $4 }')"
    : "${cpu_alloc:=0}" "${cpu_total:=0}"
    s=$(timeout "$((Q_TIMEOUT*2))" scontrol -o show nodes 2>/dev/null) && [ -n "$s" ] && \
        eval "$(printf '%s\n' "$s" | awk '
            { nrm=nam=cc=ac=cg=ag=0
              for (i=1; i<=NF; i++) {
                  if ($i ~ /^RealMemory=/) { split($i,a,"="); nrm=a[2] }
                  if ($i ~ /^AllocMem=/)   { split($i,a,"="); nam=a[2] }
                  if ($i ~ /^CfgTRES=/)    { if (match($i, /gres\/gpu=[0-9]+/)) { g=substr($i,RSTART+9,RLENGTH-9)+0; gt+=g; cg=g }
                                              if (match($i, /cpu=[0-9]+/))      cc=substr($i,RSTART+4,RLENGTH-4)+0 }
                  if ($i ~ /^AllocTRES=/)  { if (match($i, /gres\/gpu=[0-9]+/)) { g=substr($i,RSTART+9,RLENGTH-9)+0; ga+=g; ag=g }
                                              if (match($i, /cpu=[0-9]+/))      ac=substr($i,RSTART+4,RLENGTH-4)+0 } }
              trm+=nrm; tam+=nam
              # host feasibility: a free GPU is only usable if its node also
              # has the GPU-proportional share of CPU and memory free.
              if (cg > 0) {
                  cpu_per = cc/cg; mem_per = (nrm>0 ? nrm/cg : 0)
                  u = cg - ag
                  v = (cpu_per>0 ? int((cc-ac)/cpu_per) : 0)
                  w = (mem_per>0 ? int((nrm-nam)/mem_per) : 0)
                  if (v < u) u=v; if (w < u) u=w
                  if (u > 0) usable += u } }
            END { printf "mem_alloc_mb=%d mem_total_mb=%d gpu_alloc=%d gpu_total=%d gpu_usable=%d\n", tam, trm, ga, gt, usable+0 }')"
    : "${mem_alloc_mb:=0}" "${mem_total_mb:=0}" "${gpu_alloc:=0}" "${gpu_total:=0}" "${gpu_usable:=-1}"
    queue_r=$(timeout "$Q_TIMEOUT" squeue -h -t R 2>/dev/null | wc -l)
    queue_pd=$(timeout "$Q_TIMEOUT" squeue -h -t PD 2>/dev/null | wc -l)
    nodes_up=${nodes_up:-0}; nodes_down=${nodes_down:-0}
    return 0
}

# GPUs line: allocated vs total, then both availability figures:
#   avail  = GPUs with no job running on them (total - allocated)
#   usable = how many could actually be scheduled now: per node,
#            min(free gpus, free cpu / cpus-per-gpu, free mem /
#            mem-per-gpu), summed — a GPU on a host out of CPU or RAM
#            is idle but not schedulable. Falls back to raw free if the
#            baked figure is missing. (RGU/billing deliberately not used:
#            accounting weight, not admission.)
gpu_line() { # gpu_line BARW
    [ "${gpu_total:-0}" -gt 0 ] || return 0
    local gpct usable
    gpct=$(( gpu_alloc * 100 / gpu_total ))
    usable=$(( gpu_total - gpu_alloc ))
    [ "${gpu_usable:--1}" -ge 0 ] && usable=$gpu_usable
    printf '  GPUs:  '; bar "$gpct" "$1"
    printf ' %d%% (%s/%s · ' "$gpct" "$(thou "$gpu_alloc")" "$(thou "$gpu_total")"
    c '38;5;79'; printf '%s avail · ' "$(thou $(( gpu_total - gpu_alloc )))"; c '0'
    if [ "$usable" -gt 0 ]; then
        c '38;5;79'; printf '%s usable' "$(thou "$usable")"; c '0'
    else
        c '1;38;5;214'; printf '%s usable' "$(thou "$usable")"; c '0'
    fi
    printf ')\n'
}

render_cluster() {
    if ! cluster_from_cache; then
        [ "$CTLD" = 0 ] && return 0          # ctld down + no cache -> hide
        cluster_compute_live || return 0      # no/old cache -> one bounded live compute
    fi
    local total=$(( ${nodes_up:-0} + ${nodes_down:-0} ))
    [ "$total" -eq 0 ] && return 0
    hdr 'Cluster'
    local qline cpupct mempct
    cpupct=0; [ "${cpu_total:-0}" -gt 0 ] && cpupct=$(( cpu_alloc * 100 / cpu_total ))
    mempct=0; [ "${mem_total_mb:-0}" -gt 0 ] && mempct=$(( mem_alloc_mb * 100 / mem_total_mb ))
    if [ "$LAYOUT" = wide ]; then
        printf '  Nodes: '
        c '38;5;79'; printf '%s/%s up' "$nodes_up" "$total"; c '0'
        if [ "$nodes_down" -gt 0 ]; then c '38;5;214'; printf ' (%s down)' "$nodes_down"; c '0'; fi
        printf ' · Queue: '
        c '1';  printf '%s' "$(( queue_r + queue_pd ))"; c '0'
        printf ' ('
        c '38;5;79'; printf '%s running' "$queue_r"; c '0'
        printf ', '
        c '38;5;214'; printf '%s pending' "$queue_pd"; c '0'
        printf ')\n'
        printf '  CPUs:  '; bar "$cpupct" "$BARW"
        printf ' %s%% (%s/%s) · Mem: ' "$cpupct" "$(thou "$cpu_alloc")" "$(thou "$cpu_total")"
        bar "$mempct" "$BARW_SMALL"
        printf ' %s%%\n' "$mempct"
        gpu_line "$BARW"
    else
        printf '  Nodes: '
        c '38;5;79'; printf '%s/%s up' "$nodes_up" "$total"; c '0'
        if [ "$nodes_down" -gt 0 ]; then c '38;5;214'; printf ' (%s down)' "$nodes_down"; c '0'; fi
        printf '\n  Queue: '
        c '1'; printf '%s' "$(( queue_r + queue_pd ))"; c '0'
        printf ' ('
        c '38;5;79'; printf '%s run' "$queue_r"; c '0'
        printf ' / '
        c '38;5;214'; printf '%s pend' "$queue_pd"; c '0'
        printf ')\n'
        printf '  CPUs: '; bar "$cpupct" "$BARW"
        printf ' %s%%  Mem: ' "$cpupct"
        bar "$mempct" "$BARW"
        printf ' %s%%\n' "$mempct"
        gpu_line "$BARW"
    fi
    hint 'sinfo · squeue -t PD · clusterstats'
}

render_jobs() {
    command -v squeue >/dev/null 2>&1 || return 0
    local out
    out=$(timeout "$Q_TIMEOUT" squeue -u "$TUSER" -h -o '%A|%P|%j|%T|%M|%L|%R|%b' 2>/dev/null) || return 0
    local nr np
    nr=$(printf '%s\n' "$out" | grep -c '|RUNNING|' || true)
    np=$(printf '%s\n' "$out" | grep -c '|PENDING|' || true)
    if [ -z "$out" ]; then
        hdr 'Your jobs'
        c '38;5;252'; printf '  no active jobs\n'; c '0'
        hint 'squeue --me'
        return 0
    fi
    hdr 'Your jobs' "$(c '38;5;79')$nr running$(c '0') · $(c '38;5;214')$np pending$(c '0')"
    printf '%s\n' "$out" | head -n "$MAX_JOBS" | while IFS='|' read -r jid part name st tum tleft reason tres; do
        jid=$(sanitize "$jid"); part=$(sanitize "$part"); name=$(sanitize "$name")
        tum=$(sanitize "$tum"); tleft=$(sanitize "$tleft"); tres=$(sanitize "$tres")
        reason=$(sanitize "$reason")
        part=${part%%,*}; part=${part:0:16}
        name=${name:0:$NAMEW}
        if [ "$st" = RUNNING ]; then
            case "$tleft" in N/A|UNLIMITED|'') tleft='-' ;; esac
            case "$tres" in N/A|'') tres='' ;; esac
            if [ "$LAYOUT" = wide ]; then
                printf '  '
                c '1'; printf '%s' "$jid"; c '0'
                printf '  %-4s  %-16s  up %-8s  left %-8s  %s\n' "$part" "$name" "$tum" "$tleft" "$tres"
            else
                printf '  '
                c '1'; printf '%s' "$jid"; c '0'
                printf ' %s %s\n    up %s  left %s  %s\n' "$part" "$name" "$tum" "$tleft" "$tres"
            fi
        else
            reason=${reason#(}; reason=${reason%)}
            case "$reason" in
                Priority*)        reason=Priority ;;
                Resources*)       reason=Resources ;;
                Dependency*)      reason=Dependency ;;
                ReqNodeNotAvail*) reason='nodes unavailable' ;;
                *DOWN,\ DRAINED*) reason='nodes down/drained' ;;
                *) reason=$(printf '%s' "$reason" | cut -c1-28) ;;
            esac
            if [ "$LAYOUT" = wide ]; then
                c '38;5;252'; printf '  %-8s  %-4s  %-16s  held: %s\n' "$jid" "$part" "$name" "$reason"; c '0'
            else
                c '38;5;252'; printf '  %s %s %-12s held: %s\n' "$jid" "$part" "$name" "$reason"; c '0'
            fi
        fi
    done
    local total
    total=$(printf '%s\n' "$out" | grep -c .)
    if [ "$total" -gt "$MAX_JOBS" ]; then
        c '38;5;252'; printf '  … and %d more\n' "$(( total - MAX_JOBS ))"; c '0'
    fi
    hint 'squeue --me'
}

# fairshare pct + label in one awk: prints "pct|boosted|ahead|nominal|behind|throttled"
# Queue-native scale — a high factor means the scheduler ranks your jobs high:
#   boosted   >= FS_BOOST    barely used your share — jobs jump the queue
#   ahead     >= FS_AHEAD    under your share
#   nominal   >= FS_NOMINAL  around your share
#   behind    >= FS_BEHIND   over your share — expect waits
#   throttled < FS_BEHIND    well over your share — heavy waits
fs_eval() {
    awk -v f="$1" -v b="$FS_BOOST" -v a="$FS_AHEAD" -v n="$FS_NOMINAL" -v e="$FS_BEHIND" 'BEGIN{
        ff=f+0; pct=(ff<0?0:(ff>1?1:ff))*100
        if      (ff >= b+0) l="boosted"
        else if (ff >= a+0) l="ahead"
        else if (ff >= n+0) l="nominal"
        else if (ff >= e+0) l="behind"
        else                l="throttled"
        printf "%d|%s", pct, l }'
}

# LevelFS display: value (or ∞ for inf) plus a 3-level verdict — high/∞ =
# good (priority headroom), low = bad. All one LIGHT BLUE family (colorblind-
# safest hue, and visually distinct from the fairshare signal); the direction
# is carried by the word, not the color. Bright enough to read, still
# clearly secondary to the factor on the same line.
lfs_txt() {
    case "$1" in
        inf) printf '%s' "$INF_SYM" ;;
        '')  printf '' ;;
        *)   awk -v v="$1" 'BEGIN{ printf "%.2f", v+0 }' ;;
    esac
}
lfs_lab() {
    awk -v v="$1" -v lo="$LFS_LOW" -v hi="$LFS_HIGH" 'BEGIN{
        if (v == "inf" || v+0 > hi+0)  print "good"
        else if (v+0 < lo+0)           print "bad"
        else                           print "nominal" }'
}
lfs_col() { printf '38;5;117'; }   # light sky blue for all verdicts

render_fairshare_one() { # account fairshare levelfs
    local acct=$1 f=$2 lfs=${3:-} lab pct col pl ltxt lcol
    acct=$(sanitize "$acct")
    pl=$(fs_eval "$f"); pct=${pl%%|*}; lab=${pl##*|}
    case "$lab" in
        boosted)   col='1;38;5;48' ;;   # bold turquoise — top priority
        ahead)     col='38;5;79' ;;     # teal
        nominal)   col='38;5;75' ;;     # blue — the middle, neutral standing
        behind)    col='38;5;214' ;;    # orange — over your share
        throttled) col='1;38;5;203' ;;  # bold light red
        *)         col=2  ;;
    esac
    # tier word: colorblind-safe palette (channel feedback from a red-green
    # colorblind user + low-vision user). Tiers differ by LIGHTNESS and BOLD
    # first, hue second — never hue alone. boosted/ahead share the readable
    # cyan-teal family (bold splits them); nominal is plain near-white;
    # behind is orange; throttled is bold light red. All are light enough
    # to read on a dark terminal.
    case "$lab" in
        boosted)   tcol='1;38;5;48' ;;  # bold bright turquoise
        ahead)     tcol='38;5;79' ;;    # medium teal
        nominal)   tcol='38;5;250' ;;   # near-white gray — neutral middle
        behind)    tcol='38;5;214' ;;   # orange
        throttled) tcol='1;38;5;203' ;; # bold light red
        *)         tcol='38;5;250' ;;
    esac
    printf '  %-10s ' "$acct"
    mkbar "$pct" "$BARW_SMALL" "$col"
    printf ' %.2f  ' "$f"
    c "$tcol"; printf '%-9s' "$lab"; c '0'
    ltxt=$(lfs_txt "$lfs")
    if [ -n "$ltxt" ]; then
        llab=$(lfs_lab "$lfs"); lcol=$(lfs_col "$llab")
        c '38;5;252';    printf '  LevelFS '; c '0'
        c "$lcol"; printf '%s (%s)\n' "$ltxt" "$llab"; c '0'
    else
        printf '\n'
    fi
}

render_fairshare() {
    local data='' cached=0 fc="$USER_CACHE_DIR/fairshare"
    mkdir -p "$USER_CACHE_DIR" 2>/dev/null
    # 1) fresh per-user cache -> use it.
    if [ "$NO_CACHE" = 0 ] && cache_fresh "$fc" "$FAIRSHARE_TTL"; then
        data=$(cat "$fc" 2>/dev/null); [ -n "$data" ] && cached=1
    fi
    # 2) no cache (or stale) and dbd up -> compute live and write atomically.
    #    If dbd is down, do NOT compute live (would hang/fail) — use stale if any.
    if [ -z "$data" ] && [ "$DBD" = 1 ]; then
        command -v sshare >/dev/null 2>&1 || return 0
        data=$(timeout "$Q_TIMEOUT" sshare -ahP --noheader -u "$TUSER" -o Account,User,Fairshare,LevelFS 2>/dev/null \
               | awk -F'|' -v u="$TUSER" '$2 ~ u && $3 != "" { sub(/^ +/,"",$1); print $1"|"$3"|"$4 }')
        if [ -n "$data" ]; then
            printf '%s\n' "$data" > "$fc.tmp.$$" 2>/dev/null && mv -f "$fc.tmp.$$" "$fc" 2>/dev/null
        fi
    fi
    [ -n "$data" ] || return 0
    if [ "$cached" = 1 ]; then
        hdr 'Fairshare' "$(c '2;33')(cached)$(c '0')"
    else
        hdr 'Fairshare'
    fi
    local rows
    rows=$(printf '%s\n' "$data" | head -n 5)
    while IFS='|' read -r acct fsv lfs; do
        [ -n "${acct:-}" ] || continue
        render_fairshare_one "$acct" "$fsv" "$lfs"
    done <<< "$rows"
    hint 'sshare'
}

render_storage() {
    hdr 'Storage'
    local sc="$USER_CACHE_DIR/storage" rows='' cached=0
    mkdir -p "$USER_CACHE_DIR" 2>/dev/null
    # 1) fresh per-user cache -> render from it (bars re-rendered at current width).
    if [ "$NO_CACHE" = 0 ] && cache_fresh "$sc" "$STORAGE_TTL"; then
        rows=$(cat "$sc" 2>/dev/null); [ -n "$rows" ] && cached=1
    fi
    # 2) no/stale cache -> gather live (df) and write atomically.
    if [ -z "$rows" ]; then
        rows=$(storage_gather)
        if [ -n "$rows" ]; then
            printf '%s\n' "$rows" > "$sc.tmp.$$" 2>/dev/null && mv -f "$sc.tmp.$$" "$sc" 2>/dev/null
        fi
    fi
    [ -n "$rows" ] || return 0
    local ptotal=0 nproj=0 label used size p
    while IFS='|' read -r f1 f2 f3 f4; do
        if [ "$f1" = '#' ]; then ptotal=$f2; nproj=$f3; continue; fi   # meta line
        label=$f1; used=$f2; size=$f3; p=$f4
        case "$p" in *[!0-9]*|'') continue ;; esac
        label=$(sanitize "$label"); label=${label:0:12}
        if [ "$LAYOUT" = wide ]; then
            printf '  %-12s ' "$label"
            dbar "$p" "$BARW"
            printf '  %2d%%  %s / %s\n' "$p" "$used" "$size"
        else
            printf '  %-12s ' "$label"
            dbar "$p" "$BARW"
            printf ' %2d%% %s/%s\n' "$p" "$used" "$size"
        fi
    done <<< "$rows"
    if [ "$ptotal" -gt "$nproj" ]; then
        c '38;5;252'; printf '  … and %d more project dirs — df -h ~/projects/*\n' "$(( ptotal - nproj ))"; c '0'
    fi
    hint 'diskusage_report'
}

# Gather raw storage rows (one df call). Output format, parseable by
# render_storage: a leading meta line "#|ptotal|nproj", then "label|used|size|pct".
storage_gather() {
    local th="$HOME_BASE/$TUSER" p
    local -a labels=() paths=()
    # home + scratch first; then project dirs via ~/projects/* symlinks.
    # df prints one line per queried path, in order — we parse positionally
    # because every project reports the same mountpoint (/project).
    [ -e "$th" ]                  && { labels+=(home);    paths+=("$th"); }
    [ -e "$SCRATCH_BASE/$TUSER" ] && { labels+=(scratch); paths+=("$SCRATCH_BASE/$TUSER"); }
    local nproj=0 ptotal=0
    for p in "$th"/projects/*; do
        [ -L "$p" ] && [ -e "$p" ] || continue
        ptotal=$((ptotal+1))
        if [ "$nproj" -lt "$MAX_PROJECTS" ]; then
            labels+=("$(basename "$p")"); paths+=("$p"); nproj=$((nproj+1))
        fi
    done
    local out=''
    [ "${#paths[@]}" -gt 0 ] && out=$(timeout "$Q_TIMEOUT" df -h -P "${paths[@]}" 2>/dev/null)
    printf '#|%d|%d\n' "$ptotal" "$nproj"
    local i=-1 label size used pct pv
    printf '%s\n' "$out" | while read -r _fs size used _avail pct _mount _rest; do
        case "$_fs" in Filesystem|'') continue ;; esac
        i=$((i+1)); label=${labels[$i]:-?}
        pv=${pct%\%}
        case "$pv" in *[!0-9]*|'') continue ;; esac
        printf '%s|%s|%s|%s\n' "$label" "$used" "$size" "$pv"
    done
}

render_links() {
    hdr 'Links'
    if [ "$LAYOUT" = wide ]; then
        while IFS='|' read -r lab url; do
            c '38;5;252';    printf '  %-26s' "$lab"; c '0'
            c '96'; printf '%s\n' "$url";    c '0'
        done <<'LINKS'
Alliance Documentation:|docs.alliancecan.ca
AMII Engineering Docs:|docs.engineering.amii.ca
Vulcan Open OnDemand:|vulcan.alliancecan.ca
Vulcan Metrics Portal:|portal.vulcan.alliancecan.ca
Aleph Inference Service:|inference.vulcan.alliancecan.ca
Vulcan Open WebUI:|llm.vulcan.alliancecan.ca
LINKS
    else
        while IFS='|' read -r lab url; do
            c '38;5;252';    printf '  %s ' "$lab"; c '0'
            c '96'; printf '%s\n' "$url";  c '0'
        done <<'LINKS'
Alliance Documentation:|docs.alliancecan.ca
AMII Engineering Docs:|docs.engineering.amii.ca
Vulcan Open OnDemand:|vulcan.alliancecan.ca
Vulcan Metrics Portal:|portal.vulcan.alliancecan.ca
Aleph Inference Service:|inference.vulcan.alliancecan.ca
Vulcan Open WebUI:|llm.vulcan.alliancecan.ca
LINKS
    fi
}

# ============================================================================
if [ "${WANT_HELP:-0}" = 1 ]; then
    # --help: the banner itself, with a dim explanation under each block.
    render_header
    render_links
    render_cluster;   explain_cluster
    render_jobs;      explain_jobs
    render_fairshare; explain_fairshare
    render_storage;   explain_storage
    printf '\n'
    c '0'; printf 'flags: --plain · --no-cache · --only BLOCK · --user NAME (root) · --width N\n'; c '0'
    c '0'; printf 'site config: /etc/vulcan-motd/motd.conf — tier thresholds, color bands, timeouts\n'; c '0'
    exit 0
fi

case "$ONLY" in
    '')        render_header; render_links; render_cluster; render_jobs
               render_fairshare; render_storage; render_notice ;;
    header)    render_header ;;
    notice)    render_notice ;;
    cluster)   render_cluster ;;
    jobs)      render_jobs ;;
    fairshare) render_fairshare ;;
    storage)   render_storage ;;
    links)     render_links ;;
    *) printf 'vulcan-status: unknown block %s\n' "$ONLY" >&2; exit 2 ;;
esac
printf '\n'
c '38;5;252'; printf 'type vulcan-status to show this banner again · vulcan-status --help explains each section\n'; c '0'
exit 0
