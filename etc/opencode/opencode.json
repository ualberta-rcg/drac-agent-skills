{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": ["/etc/agents/AGENTS.md"],
  "permission": {
    "bash": {
      "su *": "deny",
      "su": "deny",
      "passwd *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "fdisk *": "deny",
      "shred *": "deny",
      "chmod 777 *": "deny",
      "chmod -R 777 *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "socat*": "deny",
      "telnet*": "deny",
      "wall*": "deny",
      "write *": "deny",
      "scontrol show partition*": "deny",
      "scontrol reboot*": "deny",
      "scontrol update Node*": "deny",
      "scontrol update node*": "deny",
      "scontrol update Partition*": "deny",
      "scontrol update partition*": "deny",
      "sacctmgr add*": "deny",
      "sacctmgr modify*": "deny",
      "sacctmgr remove*": "deny",
      "sacctmgr create*": "deny",
      "sacctmgr delete*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "init 0*": "deny",
      "crontab -r*": "deny",
      "visudo*": "deny",
      "vipw*": "deny",
      "scancel *": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "chown *": "ask",
      "chmod *": "ask",
      "crontab *": "ask",
      "ldapsearch *": "ask",
      "getent passwd*": "ask"
    },
    "read": {
      "/etc/shadow": "deny",
      "/etc/gshadow": "deny",
      "/etc/sudoers*": "deny",
      "/etc/sssd/**": "deny",
      "/root/**": "deny",
      "/var/spool/cron/**": "deny",
      "/var/log/**": "deny",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/config.json": "deny",
      "~/.git-credentials": "deny",
      "~/.netrc": "deny",
      "**/credentials.json": "deny",
      "**/.credentials.json": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "~/.codex/auth.json": "deny",
      "~/.pi/agent/auth.json": "deny"
    }
  }
}
