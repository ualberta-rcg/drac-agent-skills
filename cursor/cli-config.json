{
  "version": 1,
  "permissions": {
    "allow": [
      "Read(/etc/claude-code/**)",
      "Read(/etc/agents/**)"
    ],
    "deny": [
      "Shell(su)",
      "Shell(su:*)",
      "Shell(passwd)",
      "Shell(passwd:*)",
      "Shell(visudo)",
      "Shell(visudo:*)",
      "Shell(vipw)",
      "Shell(vipw:*)",
      "Shell(dd:*)",
      "Shell(mkfs:*)",
      "Shell(fdisk:*)",
      "Shell(shred:*)",
      "Shell(chmod:777*)",
      "Shell(chmod:-R 777*)",
      "Shell(crontab:-r*)",
      "Shell(nc:*)",
      "Shell(ncat:*)",
      "Shell(socat:*)",
      "Shell(telnet:*)",
      "Shell(wall)",
      "Shell(wall:*)",
      "Shell(write:*)",
      "Shell(scontrol:show partition*)",
      "Shell(scontrol:reboot*)",
      "Shell(scontrol:update Node*)",
      "Shell(scontrol:update node*)",
      "Shell(scontrol:update Partition*)",
      "Shell(scontrol:update partition*)",
      "Shell(sacctmgr:add*)",
      "Shell(sacctmgr:modify*)",
      "Shell(sacctmgr:remove*)",
      "Shell(sacctmgr:create*)",
      "Shell(sacctmgr:delete*)",
      "Shell(shutdown)",
      "Shell(shutdown:*)",
      "Shell(reboot)",
      "Shell(reboot:*)",
      "Shell(init:0*)",
      "Read(/etc/shadow)",
      "Read(/etc/gshadow)",
      "Read(/etc/sudoers*)",
      "Read(/etc/sssd/**)",
      "Read(/root/**)",
      "Read(/var/spool/cron/**)",
      "Read(/var/log/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(**/credentials.json)",
      "Read(**/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.codex/auth.json)"
    ]
  }
}
